NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://codearena:codearena@localhost:5432/codearena

# Presence fan-out and the cross-instance Yjs bridge.
REDIS_URL=redis://localhost:6379

# Redpanda's external listener. Containers on the compose network use redpanda:9092;
# processes on the host must use the advertised external address below.
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=codearena-gateway
KAFKA_SUBMISSIONS_TOPIC=code-submissions

# HS256 signing key. Any long random string for local dev; a real secret in deploy.
JWT_SECRET=dev-only-change-me-to-something-long-and-random
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (the React app, from Phase B).
CORS_ORIGIN=http://localhost:5173
